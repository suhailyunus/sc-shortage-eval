# Copy this file to .env (which is gitignored) and fill in real values.
# Never commit .env itself -- only this .example template.

SNOWFLAKE_ACCOUNT=        # e.g. ab12345.us-west-2 -- from your trial account URL
SNOWFLAKE_USER=SUPPLY_CHAIN_DBT_USER
SNOWFLAKE_PASSWORD=       # the password you set in scripts/snowflake_setup.sql, then rotated
SNOWFLAKE_ROLE=SUPPLY_CHAIN_ROLE
SNOWFLAKE_WAREHOUSE=SUPPLY_CHAIN_WH
SNOWFLAKE_DATABASE=SUPPLY_CHAIN_DB
SNOWFLAKE_SCHEMA=RAW
